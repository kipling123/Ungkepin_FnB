{
    "name": "ungkepin-monorepo",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "frontend",
        "backend"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
        "build": "npm run build:frontend",
        "build:frontend": "npm run build --workspace=frontend"
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    }
}